#pragma kernel AddForce
#pragma kernel Stir
#pragma kernel SettleStir
#pragma kernel InjectMilk
#pragma kernel Divergence
#pragma kernel SumDivergence
#pragma kernel TotalDivergence
#pragma kernel RelaxPressure
#pragma kernel SubtractGradient
#pragma kernel AdvectVelocity
#pragma kernel AdvectDye
#pragma kernel AdvectSink
#pragma kernel CorrectDye
#pragma kernel AdvectFoamCoords

#define THREAD_GROUP_SIZE 8
#define REDUCTION_GROUP_SIZE (THREAD_GROUP_SIZE * THREAD_GROUP_SIZE)

static const int2 Left = int2(-1, 0);
static const int2 Right = int2(1, 0);
static const int2 Down = int2(0, -1);
static const int2 Up = int2(0, 1);
static const float MilkEdgeTexels = 1.5;

uint _Resolution;
uint _ThreadGroupCount;
uint _PartialSumCount;
float _TexelSize;
float _CupRadius;
float _DeltaTime;

float2 _ForceFrom;
float2 _ForceTo;
float2 _ForceVelocity;
float _ForceRadius;

float2 _StirFrom;
float2 _StirTo;
float2 _StirVelocity;
float _StirRadius;
float _StirCoupling;
float _StirRetention;

float2 _MilkFrom;
float2 _MilkTo;
float _MilkRadius;

float2 _InflowCenter;
float _InflowRadius;
float _InflowRate;
float2 _BlowCenter;
float _BlowRadius;
float _BlowRate;

float _SinkFraction;
float _SinkRetention;

float2 _FoamResetMask;

float _VelocityDamping;
float _AdvectionSign;

uint _RedBlackParity;
float _RelaxationWeight;

SamplerState linearClampSampler;

Texture2D<float2> _Velocity;
RWTexture2D<float2> _VelocityOut;
Texture2D<float2> _Stir;
RWTexture2D<float2> _StirOut;
Texture2D<float> _Sink;
RWTexture2D<float> _SinkOut;
Texture2D<float4> _FoamCoords;
RWTexture2D<float4> _FoamCoordsOut;
Texture2D<float> _Dye;
Texture2D<float> _DyeForward;
Texture2D<float> _DyeBackward;
RWTexture2D<float> _DyeOut;
Texture2D<float> _Pressure;
RWTexture2D<float> _PressureInOut;
Texture2D<float> _Divergence;
RWTexture2D<float> _DivergenceOut;
StructuredBuffer<float2> _PartialSums;
RWStructuredBuffer<float2> _PartialSumsOut;
StructuredBuffer<float2> _DivergenceTotal;
RWStructuredBuffer<float2> _DivergenceTotalOut;

groupshared float2 GroupSums[REDUCTION_GROUP_SIZE];

bool IsOutsideGrid(uint2 cell)
{
    return any(cell >= _Resolution);
}

float2 CellUv(int2 cell)
{
    return (cell + 0.5) * _TexelSize;
}

bool IsFluid(int2 cell)
{
    return distance(CellUv(cell), 0.5) < _CupRadius;
}

float Gaussian(float2 offset, float radius)
{
    return exp(-dot(offset, offset) / (radius * radius));
}

float2 FlowVelocity(int2 cell)
{
    return _Velocity[cell] + _Stir[cell];
}

float InflowProfile(int2 cell)
{
    return _InflowRate * Gaussian(CellUv(cell) - _InflowCenter, _InflowRadius);
}

float BlowProfile(int2 cell)
{
    return _BlowRate * Gaussian(CellUv(cell) - _BlowCenter, _BlowRadius);
}

float MeanDivergence()
{
    float2 total = _DivergenceTotal[0];
    return total.x / max(total.y, 1);
}

void ReduceGroupSums(uint groupIndex)
{
    GroupMemoryBarrierWithGroupSync();
    for (uint stride = REDUCTION_GROUP_SIZE / 2; stride > 0; stride /= 2)
    {
        if (groupIndex < stride) GroupSums[groupIndex] += GroupSums[groupIndex + stride];
        GroupMemoryBarrierWithGroupSync();
    }
}

float NeighborPressure(int2 neighbor, float centerPressure)
{
    return IsFluid(neighbor) ? _Pressure[neighbor] : centerPressure;
}

float RelaxingNeighborPressure(int2 neighbor, float centerPressure)
{
    return IsFluid(neighbor) ? _PressureInOut[neighbor] : centerPressure;
}

float2 BlockFlowIntoWalls(int2 cell, float2 velocity)
{
    if (!IsFluid(cell + Left)) velocity.x = max(velocity.x, 0);
    if (!IsFluid(cell + Right)) velocity.x = min(velocity.x, 0);
    if (!IsFluid(cell + Down)) velocity.y = max(velocity.y, 0);
    if (!IsFluid(cell + Up)) velocity.y = min(velocity.y, 0);
    return velocity;
}

float2 ClosestPointOnSegment(float2 position, float2 start, float2 end)
{
    float2 segment = end - start;
    float segmentLengthSquared = max(dot(segment, segment), 1e-12);
    float progress = saturate(dot(position - start, segment) / segmentLengthSquared);
    return start + progress * segment;
}

float ClampToDepartureNeighborhood(float value, float2 departure)
{
    int2 corner = clamp((int2)floor(departure * _Resolution - 0.5), 0, (int)_Resolution - 2);
    float bottomLeft = _Dye[corner];
    float bottomRight = _Dye[corner + Right];
    float topLeft = _Dye[corner + Up];
    float topRight = _Dye[corner + Right + Up];
    float minimum = min(min(bottomLeft, bottomRight), min(topLeft, topRight));
    float maximum = max(max(bottomLeft, bottomRight), max(topLeft, topRight));
    return clamp(value, minimum, maximum);
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void AddForce(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;
    if (!IsFluid(cell))
    {
        _VelocityOut[cell] = 0;
        return;
    }

    float2 uv = CellUv(cell);
    float2 closestOnPath = ClosestPointOnSegment(uv, _ForceFrom, _ForceTo);
    float falloff = Gaussian(uv - closestOnPath, _ForceRadius);
    _VelocityOut[cell] = _Velocity[cell] + _ForceVelocity * falloff;
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Stir(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;
    if (!IsFluid(cell))
    {
        _StirOut[cell] = 0;
        return;
    }

    float2 uv = CellUv(cell);
    float2 closestOnPath = ClosestPointOnSegment(uv, _StirFrom, _StirTo);
    float coupling = _StirCoupling * Gaussian(uv - closestOnPath, _StirRadius);
    _StirOut[cell] = BlockFlowIntoWalls(cell, lerp(_Stir[cell], _StirVelocity, coupling));
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void SettleStir(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;
    if (!IsFluid(cell))
    {
        _StirOut[cell] = 0;
        return;
    }

    _StirOut[cell] = _Stir[cell] * _StirRetention;
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void InjectMilk(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;
    if (!IsFluid(cell))
    {
        _DyeOut[cell] = 0;
        return;
    }

    float edgeWidth = MilkEdgeTexels * _TexelSize;
    float2 uv = CellUv(cell);
    float distanceFromStream = distance(uv, ClosestPointOnSegment(uv, _MilkFrom, _MilkTo));
    float stream = 1 - smoothstep(_MilkRadius - edgeWidth, _MilkRadius, distanceFromStream);
    _DyeOut[cell] = max(_Dye[cell], stream);
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Divergence(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;
    if (!IsFluid(cell))
    {
        _DivergenceOut[cell] = 0;
        return;
    }

    float dVxDx = FlowVelocity(cell + Right).x - FlowVelocity(cell + Left).x;
    float dVyDy = FlowVelocity(cell + Up).y - FlowVelocity(cell + Down).y;
    float velocityDivergence = (dVxDx + dVyDy) * 0.5 / _TexelSize;
    float sinking = _Sink[cell] * (1 - _SinkRetention) / _DeltaTime;
    float surfaceSource = InflowProfile(cell) + BlowProfile(cell) - sinking;
    _DivergenceOut[cell] = velocityDivergence - surfaceSource;
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void SumDivergence(uint3 id : SV_DispatchThreadID, uint3 groupId : SV_GroupID, uint groupIndex : SV_GroupIndex)
{
    int2 cell = id.xy;
    bool isFluidCell = !IsOutsideGrid(id.xy) && IsFluid(cell);
    GroupSums[groupIndex] = isFluidCell ? float2(_Divergence[cell], 1) : 0;
    ReduceGroupSums(groupIndex);

    if (groupIndex == 0) _PartialSumsOut[groupId.y * _ThreadGroupCount + groupId.x] = GroupSums[0];
}

[numthreads(REDUCTION_GROUP_SIZE, 1, 1)]
void TotalDivergence(uint groupIndex : SV_GroupIndex)
{
    float2 sum = 0;
    for (uint i = groupIndex; i < _PartialSumCount; i += REDUCTION_GROUP_SIZE)
    {
        sum += _PartialSums[i];
    }

    GroupSums[groupIndex] = sum;
    ReduceGroupSums(groupIndex);

    if (groupIndex == 0) _DivergenceTotalOut[0] = GroupSums[0];
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void RelaxPressure(uint3 id : SV_DispatchThreadID)
{
    uint2 colorCell = uint2(id.x * 2 + ((id.y + _RedBlackParity) & 1), id.y);
    int2 cell = colorCell;
    if (IsOutsideGrid(colorCell)) return;
    if (!IsFluid(cell))
    {
        _PressureInOut[cell] = 0;
        return;
    }

    float center = _PressureInOut[cell];
    float neighborSum =
        RelaxingNeighborPressure(cell + Left, center) +
        RelaxingNeighborPressure(cell + Right, center) +
        RelaxingNeighborPressure(cell + Down, center) +
        RelaxingNeighborPressure(cell + Up, center);
    float balancedDivergence = _Divergence[cell] - MeanDivergence();
    float gaussSeidel = (neighborSum - balancedDivergence * _TexelSize * _TexelSize) * 0.25;
    _PressureInOut[cell] = lerp(center, gaussSeidel, _RelaxationWeight);
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void SubtractGradient(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;
    if (!IsFluid(cell))
    {
        _VelocityOut[cell] = 0;
        return;
    }

    float center = _Pressure[cell];
    float2 pressureGradient = float2(
        NeighborPressure(cell + Right, center) - NeighborPressure(cell + Left, center),
        NeighborPressure(cell + Up, center) - NeighborPressure(cell + Down, center)) * 0.5 / _TexelSize;
    float2 projectedFlow = BlockFlowIntoWalls(cell, FlowVelocity(cell) - pressureGradient);
    _VelocityOut[cell] = projectedFlow - _Stir[cell];
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void AdvectVelocity(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;
    if (!IsFluid(cell))
    {
        _VelocityOut[cell] = 0;
        return;
    }

    float2 departure = CellUv(cell) - _DeltaTime * FlowVelocity(cell);
    float2 velocity = _Velocity.SampleLevel(linearClampSampler, departure, 0);
    _VelocityOut[cell] = velocity / (1 + _VelocityDamping * _DeltaTime);
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void AdvectDye(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;
    if (!IsFluid(cell))
    {
        _DyeOut[cell] = 0;
        return;
    }

    float2 departure = CellUv(cell) - _AdvectionSign * _DeltaTime * FlowVelocity(cell);
    _DyeOut[cell] = _Dye.SampleLevel(linearClampSampler, departure, 0);
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void AdvectSink(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;
    if (!IsFluid(cell))
    {
        _SinkOut[cell] = 0;
        return;
    }

    float2 departure = CellUv(cell) - _DeltaTime * FlowVelocity(cell);
    float remaining = _Sink.SampleLevel(linearClampSampler, departure, 0) * _SinkRetention;
    float deposited = _SinkFraction * InflowProfile(cell) * _DeltaTime;
    _SinkOut[cell] = remaining + deposited;
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void CorrectDye(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;
    if (!IsFluid(cell))
    {
        _DyeOut[cell] = 0;
        return;
    }

    float2 departure = CellUv(cell) - _DeltaTime * FlowVelocity(cell);
    float corrected = _DyeForward[cell] + 0.5 * (_Dye[cell] - _DyeBackward[cell]);
    float upwelledCoffeeShare = 1 - exp(-BlowProfile(cell) * _DeltaTime);
    _DyeOut[cell] = ClampToDepartureNeighborhood(corrected, departure) * (1 - upwelledCoffeeShare);
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void AdvectFoamCoords(uint3 id : SV_DispatchThreadID)
{
    int2 cell = id.xy;
    if (IsOutsideGrid(id.xy)) return;

    float4 restingCoords = CellUv(cell).xyxy;
    if (!IsFluid(cell))
    {
        _FoamCoordsOut[cell] = restingCoords;
        return;
    }

    float2 departure = CellUv(cell) - _DeltaTime * FlowVelocity(cell);
    float4 advectedCoords = _FoamCoords.SampleLevel(linearClampSampler, departure, 0);
    _FoamCoordsOut[cell] = lerp(advectedCoords, restingCoords, _FoamResetMask.xxyy);
}
