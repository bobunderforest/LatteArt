.notice {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    align-items: center;
}

.notice__text {
    max-width: 640px;
    margin: 0;
    padding: 12px 20px;
    border-radius: 8px;
    background-color: rgba(30, 20, 15, 0.85);
    color: rgb(255, 255, 255);
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
}
